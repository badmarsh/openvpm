{
  "name": "openvpm",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:deps": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:deps:stop": "docker compose -f docker/docker-compose.dev.yml down",
    "dev:setup": "pnpm dev:deps && sleep 3 && pnpm --filter @openpims/db db:push && pnpm --filter @openpims/db db:seed",
    "dev:prod": "docker compose -f docker/docker-compose.yml up --build",
    "dev:prod:detach": "docker compose -f docker/docker-compose.yml up --build -d",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "i18n:compare": "node compare-i18n-keys.js",
    "test": "turbo test",
    "db:push": "pnpm --filter @openpims/db db:push",
    "db:generate": "pnpm --filter @openpims/db db:generate",
    "db:migrate": "pnpm --filter @openpims/db db:migrate",
    "db:seed": "pnpm --filter @openpims/db db:seed",
    "db:seed:sk": "pnpm --filter @openpims/db db:seed:sk",
    "db:reset": "pnpm --filter @openpims/db db:reset",
    "db:rls": "pnpm --filter @openpims/db db:rls",
    "db:rls:test": "pnpm --filter @openpims/db db:rls:test",
    "db:studio": "pnpm --filter @openpims/db db:studio",
    "clean": "turbo clean",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "linux"
      ],
      "cpu": [
        "x64"
      ]
    }
  }
}
